# Path to your mounted knowledge directory.
# Nabu will create this directory on first boot if it does not exist.
KNOWLEDGE_PATH=/data/nabu/knowledge

# Required: set a real password before deploying.
NABU_PASSWORD=change-me

# Optional persistent app metadata directory for shared-space leases.
NABU_DATA_PATH=/data/nabu/app-data

# Optional migration switch for strict owner note writes.
# Shared-token writes are always revision-aware.
# NABU_REQUIRE_WRITE_REVISION=false
